<Window x:Class="VoicevoxPlugin.ConfigView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoicevoxPlugin"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ConfigViewModel, IsDesignTimeCreatable=True}"
        Title="VOICEVOX読み上げプラグイン" Width="460" SizeToContent="Height" ResizeMode="CanMinimize" Background="#F0F0F0">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="10">
        <CheckBox x:Name="enabledCheckBox" Content="コメントをVOICEVOXで読み上げる" IsChecked="{Binding IsEnabled}" FontWeight="Bold" Margin="0,0,0,8"/>

        <GroupBox Header="VOICEVOXエンジン">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="URL" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding EngineUrl, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <Button Content="接続テスト・話者一覧を取得" Command="{Binding RefreshSpeakersCommand}" HorizontalAlignment="Left" Padding="8,2" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="声">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="話者" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker}" DisplayMemberPath="DisplayName" Margin="0,2"/>

                <TextBlock Grid.Row="1" Text="話速" VerticalAlignment="Center"/>
                <Slider Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding SpeedScale}" Margin="0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SpeedScale, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="2" Text="音高" VerticalAlignment="Center"/>
                <Slider Grid.Row="2" Grid.Column="1" Minimum="-0.15" Maximum="0.15" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding PitchScale}" Margin="0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PitchScale, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="3" Text="抑揚" VerticalAlignment="Center"/>
                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding IntonationScale}" Margin="0,4"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding IntonationScale, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="4" Text="音量" VerticalAlignment="Center"/>
                <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding VolumeScale}" Margin="0,4"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding VolumeScale, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="5" Text="出力先" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}" Margin="0,2"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="読み上げ内容">
            <StackPanel>
                <CheckBox Content="名前も読み上げる" IsChecked="{Binding IsReadHandleName}"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" IsEnabled="{Binding IsReadHandleName}">
                    <CheckBox x:Name="nickTitleCheckBox" Content="名前に敬称を付ける" IsChecked="{Binding IsAppendNickTitle}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NickTitle, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0" IsEnabled="{Binding IsChecked, ElementName=nickTitleCheckBox}"/>
                </StackPanel>
                <CheckBox Content="URLを「URL省略」と読む" IsChecked="{Binding IsReplaceUrl}"/>
                <CheckBox Content="184（匿名）コメントも読み上げる" IsChecked="{Binding Want184Read}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="最大文字数" VerticalAlignment="Center" Width="110"/>
                    <TextBox Text="{Binding MaxTextLength}" Width="50"/>
                    <TextBlock Text="文字を超えたら「以下略」" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="読み上げ待ちの上限" VerticalAlignment="Center" Width="110"/>
                    <TextBox Text="{Binding MaxQueueLength}" Width="50"/>
                    <TextBlock Text="件を超えたら古いものから捨てる" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="テスト">
            <StackPanel>
                <TextBox Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="テスト再生" Command="{Binding TestSpeakCommand}" Padding="8,2"/>
                    <Button Content="読み上げを止める" Command="{Binding ClearQueueCommand}" Padding="8,2" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="2,0,2,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="2,0">
            ※VOICEVOXの音声を配信で使う場合は「VOICEVOX:キャラクター名」のクレジット表記が必要です。
        </TextBlock>
    </StackPanel>
</Window>
